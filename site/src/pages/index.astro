---
import '../styles/global.css';
import { PROVIDERS, providerUrl } from '../lib/providers';

let siteData: any = { stats: { total_entities: 0, by_type: {}, by_provider: {}, custom_ids_count: 0 }, examples: [], generatedAt: '' };
try {
  siteData = await import('../lib/examples.json');
} catch {}

const { stats, examples } = siteData;

function formatNumber(n: number): string {
  if (n >= 1_000_000) return `${(n / 1_000_000).toFixed(1)}M+`;
  if (n >= 1_000) return `${Math.floor(n / 1_000)}K+`;
  return n.toLocaleString();
}

const chipColors = ['', 'blue', 'pink'] as const;

const providerCount = Object.keys(stats.by_provider).length;

const coverageProviders = Object.entries(PROVIDERS)
  .filter(([key]) => key !== 'wikidata')
  .map(([key, meta]) => ({
    key,
    ...meta,
    breadth: [meta.players, meta.teams, meta.coaches, meta.competitions, meta.seasons].filter(Boolean).length,
  }))
  .sort((a, b) => b.breadth - a.breadth || a.name.localeCompare(b.name));
---

<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Reep — The Football Entity Register</title>
  <meta name="description" content="Open-source football identity crosswalk. Resolve player, team, and competition IDs across Transfermarkt, Opta, Wyscout, Impect, and 40+ providers." />
  <link rel="icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta property="og:title" content="Reep — The Football Identity Crosswalk" />
  <meta property="og:description" content="One lookup, every ID. 490K+ entities across 44 providers." />
  <meta property="og:image" content="https://reep.football/og-image.jpg" />
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Reep — The Football Identity Crosswalk" />
  <meta name="twitter:description" content="One lookup, every ID. 490K+ entities across 44 providers." />
  <meta name="twitter:image" content="https://reep.football/og-image.jpg" />
  <meta name="twitter:creator" content="@withqwerty" />
</head>
<body>

  <!-- Hero -->
  <header class="hero">
    <div class="hero-content">
      <div class="hero-text">
        <h1 style="font-size: 2.4rem; font-weight: 700; margin-bottom: 0.15rem;">Reep</h1>
        <p style="font-size: 1.05rem; color: var(--fg-muted); margin-bottom: 0.35rem;">The football identity crosswalk</p>
        <p style="font-size: 1.3rem; font-weight: 600; margin-bottom: 0.5rem;">One lookup, every ID.</p>

        <p style="font-size: 1.6rem; font-weight: 700; color: var(--green); margin-bottom: 0.5rem;">
          {formatNumber(stats.total_entities)} entities &middot; {providerCount} providers
        </p>

        <p style="font-size: 0.95rem; color: var(--fg-muted); max-width: 720px; margin-bottom: 0.75rem;">
          Every player, team, and competition gets a stable <strong>Reep&nbsp;ID</strong>
          that never changes &mdash; linked to Transfermarkt, Opta, Wyscout, Impect, and {providerCount - 4}+
          other providers. Open-source.
          <a href="https://github.com/withqwerty/reep#data">CSVs</a> and
          <a href="https://rapidapi.com/withqwerty-withqwerty-default/api/the-reep-register">REST API</a>.
          Cross-referenced and community-verified.
        </p>

        <p style="font-size: 0.85rem; color: var(--fg-muted);">
          Built by <a href="https://x.com/withqwerty" target="_blank" rel="noopener">@withqwerty</a>
        </p>
      </div>

      <div class="hero-image">
        <picture>
          <source srcset="/reep-drawing.webp" type="image/webp" />
          <img src="/reep-drawing-opt.jpg" alt="Illustration of Charles Reep" width="300" height="200" loading="eager" />
        </picture>
      </div>
    </div>

    <div class="search-wrapper" style="margin-top: 1.25rem;">
      <input
        type="text"
        class="search-input"
        id="search-input"
        placeholder="Search by name or paste any provider ID..."
        autocomplete="off"
      />
      <div class="search-results" id="search-results"></div>
    </div>
  </header>

  <!-- Examples -->
  <p class="section-title green" style="margin-top: 1.5rem;">See it work</p>
  <div class="examples-grid" id="examples-grid">
    {examples.map((entity: any) => {
      const ids = Object.entries(entity.external_ids || {}) as [string, string][];
      return (
        <div class="card" data-reep-id={entity.reep_id}>
          <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.4rem;">
            <span style="font-size: 1.05rem; font-weight: 600;">{entity.name_en}</span>
            <span class={`badge ${entity.type === 'player' ? '' : entity.type}`}>{entity.type}</span>
          </div>
          {entity.type === 'player' && (entity.nationality || entity.position || entity.date_of_birth) && (
            <p style="font-size: 0.82rem; color: var(--fg-muted); margin-bottom: 0.6rem;">
              {[entity.nationality, entity.position, entity.date_of_birth ? `Born ${entity.date_of_birth}` : null].filter(Boolean).join(' \u00B7 ')}
            </p>
          )}
          {entity.type !== 'player' && entity.country && (
            <p style="font-size: 0.82rem; color: var(--fg-muted); margin-bottom: 0.6rem;">
              {entity.country}
            </p>
          )}
          <div style="display: flex; flex-wrap: wrap; gap: 0.3rem; margin-bottom: 0.5rem;">
            {ids.map(([provider, id], i) => {
              const url = providerUrl(provider, id as string);
              const colorClass = chipColors[i % 3];
              return url
                ? <a href={url} target="_blank" rel="noopener" class={`chip ${colorClass}`} style="text-decoration: none;">{provider}:{id}</a>
                : <span class={`chip ${colorClass}`}>{provider}:{id}</span>;
            })}
          </div>
          <p style="font-size: 0.75rem; color: var(--fg-muted);">Mapped across {ids.length} providers</p>
        </div>
      );
    })}
  </div>

  <!-- API docs -->
  <div class="content-narrow">
    <p class="section-title blue">API</p>
    <p style="font-size: 0.95rem; color: var(--fg-muted); margin-bottom: 1rem;">
      Six endpoints. Full response on every call. Get a key via
      <a href="https://rapidapi.com/withqwerty-withqwerty-default/api/the-reep-register">RapidAPI</a>.
    </p>
    <table class="endpoint-table">
      <thead>
        <tr>
          <th>Method</th>
          <th>Endpoint</th>
          <th>Description</th>
        </tr>
      </thead>
      <tbody>
        <tr><td><code>GET</code></td><td><code>/search</code></td><td>Full-text search by name or alias</td></tr>
        <tr><td><code>GET</code></td><td><code>/lookup</code></td><td>Look up by Reep ID or Wikidata QID</td></tr>
        <tr><td><code>GET</code></td><td><code>/resolve</code></td><td>Resolve a provider ID to all others</td></tr>
        <tr><td><code>GET</code></td><td><code>/stats</code></td><td>Entity and provider coverage counts</td></tr>
        <tr><td><code>POST</code></td><td><code>/batch/lookup</code></td><td>Look up multiple IDs (max 100)</td></tr>
        <tr><td><code>POST</code></td><td><code>/batch/resolve</code></td><td>Resolve multiple provider IDs (max 100)</td></tr>
      </tbody>
    </table>

    <pre style="margin-top: 1rem;"><code>curl "https://reep-api.rahulkeerthi2-95d.workers.dev/resolve?provider=transfermarkt&id=568177" \
  -H "X-RapidAPI-Proxy-Secret: YOUR_KEY"</code></pre>

    <div style="display: flex; gap: 0.75rem; margin-top: 1.25rem;">
      <a href="https://rapidapi.com/withqwerty-withqwerty-default/api/the-reep-register" target="_blank" rel="noopener" class="cta">Get API key</a>
      <a href="https://github.com/withqwerty/reep" target="_blank" rel="noopener" class="cta outline">View on GitHub</a>
      <a href="https://github.com/withqwerty/reep#data" target="_blank" rel="noopener" class="cta outline">Download CSVs</a>
    </div>
  </div>

  <!-- Provider coverage -->
  <div class="content-narrow">
    <p class="section-title pink">Provider coverage</p>
    <div style="overflow-x: auto;">
      <table class="coverage-table">
        <thead>
          <tr>
            <th>Provider</th>
            <th>Players</th>
            <th>Teams</th>
            <th>Coaches</th>
            <th>Comps</th>
            <th>Seasons</th>
            <th>Source</th>
          </tr>
        </thead>
        <tbody>
          {coverageProviders.map((p) => (
            <tr>
              <td style="font-weight: 500;">{p.name}</td>
              <td>{p.players ? '\u2713' : ''}</td>
              <td>{p.teams ? '\u2713' : ''}</td>
              <td>{p.coaches ? '\u2713' : ''}</td>
              <td>{p.competitions ? '\u2713' : ''}</td>
              <td>{p.seasons ? '\u2713' : ''}</td>
              <td style="font-size: 0.8rem; color: var(--fg-muted);">{p.source}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <!-- Contribute -->
  <div class="content-narrow">
    <p class="section-title muted">Share data</p>
    <div class="card" style="max-width: 600px;">
      <p style="font-size: 0.95rem; margin-bottom: 0.75rem;">
        Anonymous. No account, no tracking.
      </p>
      <p style="font-size: 0.85rem; color: var(--fg-muted); margin-bottom: 1rem;">
        CSV preferred. Any format with provider IDs works.
      </p>
      <div id="drop-zone" style="border: 2px dashed var(--border); border-radius: var(--radius); padding: 2rem; text-align: center; cursor: pointer; transition: border-color 0.15s;">
        <p style="font-size: 0.95rem; color: var(--fg-muted);" id="drop-text">Drop a file here</p>
        <input type="file" id="file-input" style="display: none;" />
      </div>
      <p id="upload-status" style="font-size: 0.85rem; margin-top: 0.5rem; display: none;"></p>
    </div>
  </div>

  <!-- Footer -->
  <footer class="content-narrow">
    <div class="footer-reep">
      <picture>
        <source srcset="/reep-writing.webp" type="image/webp" />
        <img src="/reep-writing.jpg" alt="Charles Reep's match notation from the 1953 FA Cup Final" class="footer-writing" width="280" height="157" loading="lazy" />
      </picture>
      <div>
        <p style="margin-bottom: 0.5rem;">
          Named after <a href="https://en.wikipedia.org/wiki/Charles_Reep" target="_blank" rel="noopener">Charles Reep</a>
          (1904&ndash;2002), who hand-recorded every action in 2,200+ matches &mdash; football analytics before data existed.
        </p>
        <div>
          <a href="https://github.com/withqwerty/reep" target="_blank" rel="noopener">GitHub</a>
          <a href="https://rapidapi.com/withqwerty-withqwerty-default/api/the-reep-register" target="_blank" rel="noopener">RapidAPI</a>
          <a href="https://x.com/withqwerty" target="_blank" rel="noopener">@withqwerty</a>
          <a href="https://github.com/withqwerty/reep/blob/main/LICENSE" target="_blank" rel="noopener">MIT</a>
        </div>
      </div>
    </div>
  </footer>

  <!-- Client-side search + file upload -->
  <script>
    import Fuse from 'fuse.js';
    import { detectInput } from '../lib/detect';

    type IndexEntity = {
      reep_id: string;
      qid: string | null;
      name_en: string;
      aliases_en: string | null;
      type: string;
      date_of_birth: string | null;
      nationality: string | null;
      country: string | null;
      position: string | null;
      provider_count: number;
      external_ids: Record<string, string>;
    };

    let index: IndexEntity[] | null = null;
    let fuse: Fuse<IndexEntity> | null = null;
    let debounceTimer: ReturnType<typeof setTimeout> | null = null;

    const input = document.getElementById('search-input') as HTMLInputElement;
    const resultsEl = document.getElementById('search-results') as HTMLDivElement;
    const grid = document.getElementById('examples-grid') as HTMLDivElement;

    // --- SEARCH ---

    async function loadIndex() {
      if (index) return;
      const resp = await fetch('/search-index.json');
      index = await resp.json() as IndexEntity[];
      fuse = new Fuse(index, {
        keys: ['name_en', 'aliases_en'],
        threshold: 0.3,
        limit: 20,
      });
    }

    input.addEventListener('focus', loadIndex);

    input.addEventListener('input', () => {
      if (debounceTimer) clearTimeout(debounceTimer);
      debounceTimer = setTimeout(doSearch, 200);
    });

    function doSearch() {
      const raw = input.value;
      if (!raw.trim() || !index || !fuse) {
        resultsEl.classList.remove('open');
        return;
      }

      const detected = detectInput(raw);
      let results: IndexEntity[] = [];

      if (detected.kind === 'name') {
        results = fuse.search(detected.query, { limit: 20 }).map(r => r.item);
      } else if (detected.kind === 'reep_id') {
        const match = index.find(e => e.reep_id === detected.id);
        if (match) results = [match];
      } else if (detected.kind === 'qid') {
        const match = index.find(e => e.qid === detected.id);
        if (match) results = [match];
      } else if (detected.kind === 'numeric') {
        results = index.filter(e => {
          return Object.values(e.external_ids).some(v => v === detected.id);
        }).slice(0, 20);
      }

      renderResults(results);
    }

    function renderResults(results: IndexEntity[]) {
      resultsEl.textContent = '';
      if (results.length === 0) {
        resultsEl.classList.remove('open');
        return;
      }

      for (const entity of results) {
        const item = document.createElement('div');
        item.className = 'search-result-item';

        const nameSpan = document.createElement('span');
        nameSpan.style.fontWeight = '600';
        nameSpan.textContent = entity.name_en;

        const badge = document.createElement('span');
        badge.className = `badge ${entity.type === 'player' ? '' : entity.type}`;
        badge.textContent = entity.type;
        badge.style.marginLeft = '0.4rem';

        const countSpan = document.createElement('span');
        countSpan.style.cssText = 'float: right; font-size: 0.8rem; color: var(--fg-muted); margin-top: 0.15rem;';
        countSpan.textContent = `${entity.provider_count} providers`;

        item.appendChild(nameSpan);
        item.appendChild(badge);
        item.appendChild(countSpan);

        item.addEventListener('click', () => selectResult(entity));
        resultsEl.appendChild(item);
      }

      resultsEl.classList.add('open');
    }

    function selectResult(entity: IndexEntity) {
      resultsEl.classList.remove('open');
      input.value = entity.name_en;

      const existing = grid.querySelector(`[data-reep-id="${entity.reep_id}"]`) as HTMLElement | null;
      if (existing) {
        existing.scrollIntoView({ behavior: 'smooth', block: 'center' });
        existing.classList.add('highlight');
        setTimeout(() => existing.classList.remove('highlight'), 2000);
        return;
      }

      const card = document.createElement('div');
      card.className = 'card highlight';
      card.dataset.reepId = entity.reep_id;
      card.style.borderColor = 'var(--green)';

      const header = document.createElement('div');
      header.style.cssText = 'display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.4rem;';

      const name = document.createElement('span');
      name.style.cssText = 'font-size: 1.05rem; font-weight: 600;';
      name.textContent = entity.name_en;

      const typeBadge = document.createElement('span');
      typeBadge.className = `badge ${entity.type === 'player' ? '' : entity.type}`;
      typeBadge.textContent = entity.type;

      header.appendChild(name);
      header.appendChild(typeBadge);
      card.appendChild(header);

      if (entity.type === 'player') {
        const parts = [entity.nationality, entity.position, entity.date_of_birth ? `Born ${entity.date_of_birth}` : null].filter(Boolean);
        if (parts.length > 0) {
          const bio = document.createElement('p');
          bio.style.cssText = 'font-size: 0.82rem; color: var(--fg-muted); margin-bottom: 0.6rem;';
          bio.textContent = parts.join(' \u00B7 ');
          card.appendChild(bio);
        }
      } else if (entity.country) {
        const bio = document.createElement('p');
        bio.style.cssText = 'font-size: 0.82rem; color: var(--fg-muted); margin-bottom: 0.6rem;';
        bio.textContent = entity.country;
        card.appendChild(bio);
      }

      const chipColors = ['', 'blue', 'pink'];
      const chipsDiv = document.createElement('div');
      chipsDiv.style.cssText = 'display: flex; flex-wrap: wrap; gap: 0.3rem; margin-bottom: 0.5rem;';

      const ids = Object.entries(entity.external_ids);
      ids.forEach(([provider, id], i) => {
        const chip = document.createElement('span');
        chip.className = `chip ${chipColors[i % 3]}`;
        chip.textContent = `${provider}:${id}`;
        chipsDiv.appendChild(chip);
      });

      card.appendChild(chipsDiv);

      const count = document.createElement('p');
      count.style.cssText = 'font-size: 0.75rem; color: var(--fg-muted);';
      count.textContent = `Mapped across ${ids.length} providers`;
      card.appendChild(count);

      grid.insertBefore(card, grid.firstChild);
      card.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }

    document.addEventListener('click', (e) => {
      if (!resultsEl.contains(e.target as Node) && e.target !== input) {
        resultsEl.classList.remove('open');
      }
    });

    // --- FILE UPLOAD (anonymous dead drop to /contribute on the Worker) ---

    const dropZone = document.getElementById('drop-zone') as HTMLDivElement;
    const fileInput = document.getElementById('file-input') as HTMLInputElement;
    const dropText = document.getElementById('drop-text') as HTMLParagraphElement;
    const statusEl = document.getElementById('upload-status') as HTMLParagraphElement;

    const MAX_SIZE = 10 * 1024 * 1024; // 10MB

    dropZone.addEventListener('click', () => fileInput.click());

    dropZone.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropZone.style.borderColor = 'var(--green)';
    });

    dropZone.addEventListener('dragleave', () => {
      dropZone.style.borderColor = 'var(--border)';
    });

    dropZone.addEventListener('drop', (e) => {
      e.preventDefault();
      dropZone.style.borderColor = 'var(--border)';
      const file = e.dataTransfer?.files[0];
      if (file) uploadFile(file);
    });

    fileInput.addEventListener('change', () => {
      const file = fileInput.files?.[0];
      if (file) uploadFile(file);
    });

    async function uploadFile(file: File) {
      if (file.size > MAX_SIZE) {
        showStatus('File too large (max 10MB)', 'var(--pink)');
        return;
      }

      dropText.textContent = `Uploading ${file.name}...`;
      statusEl.style.display = 'none';

      try {
        const formData = new FormData();
        formData.append('file', file);

        const resp = await fetch('https://reep-api.rahulkeerthi2-95d.workers.dev/contribute', {
          method: 'POST',
          body: formData,
        });

        if (resp.ok) {
          dropText.textContent = 'Drop a file here';
          showStatus('Thanks! We\'ll review your data.', 'var(--green)');
        } else {
          const msg = await resp.text().catch(() => 'Upload failed');
          dropText.textContent = 'Drop a file here';
          showStatus(msg, 'var(--pink)');
        }
      } catch {
        dropText.textContent = 'Drop a file here';
        showStatus('Upload failed. Try again later.', 'var(--pink)');
      }
    }

    function showStatus(msg: string, color: string) {
      statusEl.textContent = msg;
      statusEl.style.color = color;
      statusEl.style.display = 'block';
    }
  </script>

</body>
</html>
